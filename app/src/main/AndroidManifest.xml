<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".core.di.MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyAlquran"
        tools:targetApi="31" >

        <!--
          LATIHAN VIDA - credential yang disuntik lewat manifestPlaceholders.
          Nilai ${sdkActivationKey} diisi saat merge manifest dari
          app/build.gradle.kts per flavor. Kalau placeholder tidak terdefinisi,
          manifest merger gagal dengan pesan yang menyebut nama placeholder-nya.
        -->
        <meta-data
            android:name="sdk_activation_key"
            android:value="${sdkActivationKey}" />

        <activity
            android:name=".presentation.vida.VidaActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.news.NewsActivity"
            android:exported="false" />
        <activity android:name=".presentation.detail.DetailActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.favorite.FavoriteActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.home.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>